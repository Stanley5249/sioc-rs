{
  "prettier": {
    "allowed": false
  },
  // oxlint lints JavaScript and TypeScript here, so ESLint stays off.
  "language_servers": ["!eslint", "..."],
  "file_scan_exclusions": [
    "...",
    // Rust
    "**/target",
    // Python
    "**/.venv",
    "**/.ruff_cache",
    // JavaScript
    "**/node_modules"
  ],
  "languages": {
    "JavaScript": {
      "language_servers": ["!eslint", "..."]
    },
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "Markdown": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TOML": {
      "formatter": {
        "language_server": {
          "name": "tombi"
        }
      },
      "language_servers": ["!oxfmt", "..."]
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["!eslint", "..."]
    },
    "YAML": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        // rustfmt.toml requires nightly; keep this pin in sync with justfile.
        "rustfmt": {
          "overrideCommand": ["rustfmt", "+nightly-2026-07-20", "--edition", "2024"]
        }
      }
    }
  }
}
